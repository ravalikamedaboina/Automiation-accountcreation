# Environment Configuration
# Copy this file to .env and update the values

# API URLs
TOKEN_API_URL=https:/oauth2/default/v1/token
ENROLLMENT_API_URL=/enrollment/api/join-mileage-plan

# Alaska Airlines OAuth Credentials
# The Basic Auth token from the curl command (base64 encoded client_id:client_secret)
BASIC_AUTH_TOKEN=

# Alaska Airlines API Configuration
OCP_APIM_SUBSCRIPTION_KEY=
LMS_OVERRIDE=LPS

# Error Mitigation Configuration
MAX_RETRIES=3
RETRY_DELAY=2000
REQUEST_TIMEOUT=30000
RATE_LIMIT_DELAY=1000
